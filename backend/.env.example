DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development defaults to SQLite. Set DATABASE_URL to use PostgreSQL locally.
# DATABASE_URL=postgres://housepot:change-me@127.0.0.1:5432/housepot

# SMTP settings (development defaults to console email).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Housepot <noreply@example.com>

# JWT_ACCESS_MINUTES=10
# JWT_REFRESH_DAYS=7
# API_ANON_RATE=120/hour
# API_USER_RATE=1200/hour

# Production only: set DJANGO_SETTINGS_MODULE=config.settings.prod, DATABASE_URL,
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, and SMTP settings.
# USE_S3_STORAGE=true
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
